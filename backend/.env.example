PORT=3000
DB_PATH=./database.sqlite

# Correo (opcional). Si SMTP_USER y SMTP_PASS quedan vacíos, los correos se simulan en la consola.
# Con Gmail: SMTP_USER = tu correo y SMTP_PASS = una "contraseña de aplicación" de 16 caracteres,
# sin espacios (NO tu contraseña normal). Estos datos van solo en tu .env, que Git ignora.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=VoyBus <tu_correo@gmail.com>
